<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aurora.admin.mapper.ProductMapper">

    <sql id="productFilterWhere">
        <if test="keyword != null and keyword != ''">AND p.name LIKE CONCAT('%', #{keyword}, '%')</if>
        <if test="categoryId != null">AND p.category_id = #{categoryId}</if>
        <if test="status != null and status != ''">AND p.status = #{status}</if>
    </sql>

    <sql id="productJoinSelect">
        SELECT p.*, c.name AS category_name
        FROM t_product p
        LEFT JOIN t_product_category c ON p.category_id = c.id AND c.is_deleted = 0
    </sql>

    <select id="findPageWithFilter" resultType="com.aurora.admin.entity.Product">
        <include refid="productJoinSelect"/>
        WHERE p.is_deleted = 0
        <include refid="productFilterWhere"/>
        ORDER BY p.create_time DESC
        LIMIT #{offset}, #{size}
    </select>

    <select id="countFiltered" resultType="long">
        SELECT COUNT(*) FROM t_product p
        WHERE p.is_deleted = 0
        <include refid="productFilterWhere"/>
    </select>

    <update id="batchUpdateStatus">
        UPDATE t_product SET status = #{status}
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND is_deleted = 0
    </update>

</mapper>
