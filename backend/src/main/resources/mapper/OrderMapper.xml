<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aurora.admin.mapper.OrderMapper">

    <!-- ========== 可复用 SQL 片段 ========== -->

    <sql id="orderFilterWhere">
        o.is_deleted = 0
        <if test="userId != null">AND o.user_id = #{userId}</if>
        <if test="status != null and status != ''">AND o.status = #{status}</if>
        <if test="orderNo != null and orderNo != ''">AND o.order_no LIKE CONCAT('%', #{orderNo}, '%')</if>
        <if test="username != null and username != ''">AND u.username LIKE CONCAT('%', #{username}, '%')</if>
    </sql>

    <sql id="orderJoinSelect">
        SELECT o.*, u.username
        FROM t_order o
        LEFT JOIN t_user u ON o.user_id = u.id AND u.is_deleted = 0
    </sql>

    <!-- ========== 分页查询 ========== -->

    <select id="findPage" resultType="com.aurora.admin.entity.Order">
        <include refid="orderJoinSelect"/>
        <where><include refid="orderFilterWhere"/></where>
        ORDER BY o.create_time DESC
        LIMIT #{offset}, #{size}
    </select>

    <select id="countFiltered" resultType="long">
        SELECT COUNT(*)
        FROM t_order o
        LEFT JOIN t_user u ON o.user_id = u.id AND u.is_deleted = 0
        <where><include refid="orderFilterWhere"/></where>
    </select>

    <select id="findForExport" resultType="com.aurora.admin.entity.Order">
        <include refid="orderJoinSelect"/>
        <where><include refid="orderFilterWhere"/></where>
        ORDER BY o.create_time DESC
        LIMIT #{limit}
    </select>

    <!-- ========== 批量操作 ========== -->

    <select id="countByIdsAndUser" resultType="int">
        SELECT COUNT(*) FROM t_order
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND user_id = #{userId}
        AND is_deleted = 0
    </select>

    <update id="batchDeleteCancelled">
        UPDATE t_order SET is_deleted = 1
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND status = 'CANCELLED'
        AND is_deleted = 0
    </update>

</mapper>
